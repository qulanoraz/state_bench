flowchart TB
  subgraph APP["Flutter app (profile build, Android device)"]
    G["UpdateGenerator<br/>Timer.periodic, Random(seed=42)<br/>10/30/60/120 updates/s"] --> S{{"TelemetrySink<br/>(interface)"}}
    S -->|"LIB=bloc"| B1["BlocSink → DashboardBloc<br/>add(SampleArrived) → emit(state)"]
