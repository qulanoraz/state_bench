    UI --> FR["FrameRecorder<br/>FrameTiming: build, raster, vsync<br/>RSS 1 Hz"]
  end
  FR --> IT["integration_test<br/>traceAction (Dart, Embedder, GC)<br/>reportData"]
  IT --> DRV["perf_driver.dart (host)<br/>run_frames.json + timeline_summary.json"]
  RUN["run_matrix.py<br/>randomised order, cooldown, log"] --> IT
  DRV --> AN["analysis/analyze.py<br/>trim warm-up → per-run metrics →<br/>Mann–Whitney, A12, Holm, permutation, Spearman"]
